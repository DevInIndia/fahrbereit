# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- model
# Which provider the factory resolves. One of: gemini, cerebras, groq.
MODEL_PROVIDER=gemini

# Interactive path. Anything a user waits on, including narration.
# Free tier, verified 2026-08-08: 15 RPM, 250K TPM, 500 RPD.
MODEL_REASONING=gemini-3.5-flash-lite

# Bulk and offline path. Evaluation judging, persona expansion, cache warming.
# Free tier: 30 RPM, 16K TPM, 14400 RPD, but roughly sixteen times the latency
# of the reasoning model, so it must not sit on an interactive path.
MODEL_CHEAP=gemma-4-31b-it

# Google AI Studio key. Obtain free, no card, at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Only needed when MODEL_PROVIDER is cerebras or groq. Both are OpenAI compatible.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# ---------------------------------------------------------------- budget
# Log every model call with its type and model, so usage per session is countable.
MODEL_CALL_LOG=1

# Development response cache keyed on prompt hash. Re-running the same test
# conversation must not cost quota every time. Turn off for a real demonstration.
MODEL_CACHE=1
MODEL_CACHE_PATH=state/model_cache.sqlite

# ---------------------------------------------------------------- payment
# The only implementation in this repository is the mock. There is no real
# gateway, no card form, and no payment rail anywhere in this codebase.
PAYMENT_PROVIDER=mock

# ---------------------------------------------------------------- tracing
# Optional. Langfuse Hobby tier is free and needs no card.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
