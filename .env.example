# Copy this file to .env and fill in GOOGLE_API_KEY. Nothing else is required.
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed.

# ---------------------------------------------------------------- required
# Google AI Studio key. Free, no credit card, from https://aistudio.google.com/apikey
# Without it the interface still runs and the persona shortcuts still work, because
# they call no model. Only the chat needs this.
GOOGLE_API_KEY=

# ---------------------------------------------------------------- model
# Which provider the factory resolves. One of: gemini, cerebras, groq.
MODEL_PROVIDER=gemini

# Interactive path: anything a user waits on, narration included.
# Free tier, verified 2026-08-08: 15 requests/minute, 500/day.
MODEL_REASONING=gemini-3.5-flash-lite

# Bulk and offline path: evaluation judging, persona expansion, cache warming.
# 30/minute and 14,400/day, but roughly sixteen times the latency, so it must never
# sit on a path a user is waiting on.
MODEL_CHEAP=gemma-4-31b-it

# Only needed when MODEL_PROVIDER is cerebras or groq. Both are OpenAI compatible.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# ---------------------------------------------------------------- budget
# Log every model call with its type and model, so usage per session is countable.
MODEL_CALL_LOG=1

# Development response cache, keyed on prompt hash, so repeating the same test
# conversation costs no quota. Leave at 0 for a demonstration: a cached answer to a
# question that was not asked is worse than a slow one.
MODEL_CACHE=0
MODEL_CACHE_PATH=state/model_cache.sqlite

# ---------------------------------------------------------------- payment
# The only implementation in this repository is the mock. There is no real gateway,
# no card form, and no payment rail anywhere in this codebase, in any environment.
PAYMENT_PROVIDER=mock

# ---------------------------------------------------------------- tracing
# Optional. Langfuse Hobby tier is free and needs no card. Leave blank to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
