# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
ENV/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
.vite/

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# IDEs & Editor configs
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# Runtime state
state/
*.sqlite
*.sqlite3

# Eval output. evals/results.json is the published live run and is committed on
# purpose. The offline run is a local check of the deterministic pipeline only, and
# must never be mistaken for it.
evals/results_offline.json
evals/results/*.json
evals/results/*.md
!evals/results/.gitkeep

# OS
.DS_Store
Thumbs.db

# Local run logs & temporary files
backend.log
backend.err.log
*.log
*.tmp
*.bak
